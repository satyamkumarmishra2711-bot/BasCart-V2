# BasCart Environment Configuration
# Copy this file to .env and fill in your values. Never commit secrets to git.

# Google Sheets Integration
# ID of the Google Spreadsheet to use as the database (e.g. from https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_sheets_spreadsheet_id_here"

# Google Service Account client email that has Editor access to the spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"

# Google Service Account private key (preserve newlines or use \n formatting)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Supabase Auth Configuration
# Obtain from your Supabase project settings -> API
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Admin Access Control & OTP Sender
# noreply.bascart@gmail.com is designated as primary admin for all system & sheet operations
ADMIN_EMAILS="noreply.bascart@gmail.com,satyamkumarmishra2711@gmail.com,admin@bascart.com"
EMAIL_FROM="noreply.bascart@gmail.com"

# Optional Cloud Storage or Media Base URL
PRODUCT_MEDIA_BASE_URL=""

# Server Port
PORT=3000
